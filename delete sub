import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        String S = sc.nextLine();
        int start = sc.nextInt();
        int end = sc.nextInt();
        
        String modified = S.substring(0, start) + S.substring(end);
        System.out.println(modified);
    }
}
